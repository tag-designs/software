set(PROJECT_SOURCE_DIR "@PROJECT_SOURCE_DIR@")
set(DEVELOPER_DOCS_SOURCE_DIR "@DEVELOPER_DOCS_SOURCE_DIR@")
set(DEVELOPER_DOCS_STAGING_DIR "@DEVELOPER_DOCS_STAGING_DIR@")
set(DEVELOPER_DOCS_MARKDOWN "@DEVELOPER_DOCS_MARKDOWN@")

file(REMOVE_RECURSE "${DEVELOPER_DOCS_STAGING_DIR}")
file(MAKE_DIRECTORY "${DEVELOPER_DOCS_STAGING_DIR}/src")

file(
  COPY "${DEVELOPER_DOCS_SOURCE_DIR}/src/"
  DESTINATION "${DEVELOPER_DOCS_STAGING_DIR}/src")

file(
  COPY "${DEVELOPER_DOCS_SOURCE_DIR}/mkdocs.yml"
  DESTINATION "${DEVELOPER_DOCS_STAGING_DIR}")

foreach(doc IN LISTS DEVELOPER_DOCS_MARKDOWN)
  set(source_file "${PROJECT_SOURCE_DIR}/${doc}")
  set(output_file "${DEVELOPER_DOCS_STAGING_DIR}/src/reference/${doc}")
  get_filename_component(source_dir "${source_file}" DIRECTORY)
  get_filename_component(output_dir "${output_file}" DIRECTORY)
  file(MAKE_DIRECTORY "${output_dir}")
  file(COPY_FILE "${source_file}" "${output_file}")

  file(
    GLOB local_assets
    LIST_DIRECTORIES false
    "${source_dir}/*.gif"
    "${source_dir}/*.jpg"
    "${source_dir}/*.jpeg"
    "${source_dir}/*.png"
    "${source_dir}/*.svg"
    # Measurement data cited by a document. A results page whose raw data is
    # not downloadable alongside it is a claim without its evidence.
    "${source_dir}/*.csv")
  if(local_assets)
    file(COPY ${local_assets} DESTINATION "${output_dir}")
  endif()

  # Figures kept in an images/ subdirectory beside the markdown, rather than
  # alongside it. The glob above matches only "${source_dir}/*.png" and friends,
  # so without this a staged page renders in the portal with broken images --
  # the document is present and reachable, which makes the omission easy to miss
  # until someone opens the page.
  # Figures the document references by path, wherever they live in the tree.
  # The globs above only find assets sitting beside the markdown, so a document
  # pointing at an image in another directory -- the user-guide screenshots, for
  # one -- published as a page with a broken figure and nothing said so.
  file(READ "${source_file}" _doc_text)
  set(_scan "${_doc_text}")
  # A sentinel rather than while(TRUE): this file runs as a cmake -P script,
  # where CMP0012 is unset and the constant is not recognised as a boolean, so
  # the loop body never ran at all.
  set(_scanning YES)
  while(_scanning)
    # One match at a time: REGEX MATCHALL returns the hits as a single list
    # element when the document text carries semicolons, which silently
    # produced one nonsense path instead of each figure.
    string(REGEX MATCH "\\]\\(([^)]+\\.(png|jpg|jpeg|gif|svg))\\)"
           _hit "${_scan}")
    if(NOT _hit)
      set(_scanning NO)
      continue()
    endif()
    set(_rel "${CMAKE_MATCH_1}")
    string(FIND "${_scan}" "${_hit}" _pos)
    string(LENGTH "${_hit}" _len)
    math(EXPR _advance "${_pos} + ${_len}")
    string(SUBSTRING "${_scan}" ${_advance} -1 _scan)

    if(_rel MATCHES "^(https?:|file:|/|#)")
      continue()
    endif()
    get_filename_component(_figure "${source_dir}/${_rel}" ABSOLUTE)
    file(RELATIVE_PATH _figure_rel "${PROJECT_SOURCE_DIR}" "${_figure}")
    # Outside the repository (a sibling hardware checkout, say): nothing to copy.
    if(_figure_rel MATCHES "^\\.\\." OR NOT EXISTS "${_figure}")
      continue()
    endif()
    set(_figure_out "${DEVELOPER_DOCS_STAGING_DIR}/src/reference/${_figure_rel}")
    get_filename_component(_figure_out_dir "${_figure_out}" DIRECTORY)
    file(MAKE_DIRECTORY "${_figure_out_dir}")
    file(COPY_FILE "${_figure}" "${_figure_out}")
  endwhile()

  if(IS_DIRECTORY "${source_dir}/images")
    file(
      COPY "${source_dir}/images"
      DESTINATION "${output_dir}"
      FILES_MATCHING
        PATTERN "*.gif"
        PATTERN "*.jpg"
        PATTERN "*.jpeg"
        PATTERN "*.png"
        PATTERN "*.svg")
  endif()
endforeach()

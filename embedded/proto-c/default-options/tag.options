// Default nanopb options shared by embedded tag command protocols.
* long_names:false

Ack.error_message max_size:64
Status.debug_message max_size:128
StateLog.states max_count:10

// Keep common command/status payloads enabled by default, but disable
// tag-specific log and calibration payloads until a tag override enables them.
Ack.*_data_log type:FT_IGNORE
Ack.calibration_log type:FT_IGNORE
Ack.calibration_constants type:FT_IGNORE
Req.write_calibration type:FT_IGNORE

// State marker detail is carried only by targets whose flash marker record has
// room for it, which is the STM32U3 padding for the 128-bit programming row.
// STM32L4 markers are 24 bytes of real fields with no slack, so those targets
// can never populate this and should not pay for the struct member or the
// field descriptor: generating it shifted every STM32L4 image. Enabled by the
// IMUTag override.
State.transition_detail type:FT_IGNORE

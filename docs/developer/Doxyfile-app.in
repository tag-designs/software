# Doxygen configuration for one host application's API reference.
#
# Each application gets its own run, because qtmonitor, qtprogram, qtcalibrate
# and sensorviz each define their own MainWindow and LogWindow: one run would
# merge same-named classes into one page. CMake configures this once per
# application (DEVELOPER_DOXYGEN_APPS in the top-level CMakeLists.txt). Its
# tag file comes from a pass over the host libraries only (see
# DEVELOPER_DOXYGEN_TAGFILE there), so links to Tag, ConfigShape and the like
# lead to the library reference one directory up, while words such as start or
# main in application code are not linked to firmware functions of that name.

PROJECT_NAME           = "@APP_DOC_TITLE@"
PROJECT_BRIEF          = "@APP_DOC_BRIEF@"
OUTPUT_DIRECTORY       = @DEVELOPER_DOXYGEN_OUTPUT_DIR@
HTML_OUTPUT            = api/@APP_DOC_NAME@
TAGFILES               = @DEVELOPER_DOXYGEN_TAGFILE@=..

GENERATE_HTML          = YES
GENERATE_LATEX         = NO
GENERATE_XML           = NO

INPUT                  = @PROJECT_SOURCE_DIR@/@APP_DOC_DIR@

RECURSIVE              = YES
FILE_PATTERNS          = *.c *.cc *.cpp *.h *.hpp
EXCLUDE_PATTERNS       = */archive/* \
                         */build-*/* \
                         */CMakeFiles/* \
                         */qcustomplot/*

EXTRACT_ALL            = NO
# An application has no public API; its maintainers need its private slots
# and members, where most of its logic and documentation are.
EXTRACT_PRIVATE        = YES
EXTRACT_STATIC         = YES
HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO

WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_AS_ERROR          = NO
WARN_LOGFILE           = @APP_DOC_WARN_LOG@
QUIET                  = YES

SOURCE_BROWSER         = YES
INLINE_SOURCES         = NO
REFERENCED_BY_RELATION = YES
REFERENCES_RELATION    = YES
GENERATE_TREEVIEW      = YES
SEARCHENGINE           = YES
FULL_PATH_NAMES        = YES
STRIP_FROM_PATH        = @PROJECT_SOURCE_DIR@

OPTIMIZE_OUTPUT_FOR_C  = NO
MARKDOWN_SUPPORT       = YES

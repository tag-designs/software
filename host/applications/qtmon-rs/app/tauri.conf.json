{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tag Monitor",
  "version": "2.1.0",
  "identifier": "com.tagdesigns.qtmon",
  "build": {
    "frontendDist": "dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Tag Monitor v2.1",
        "width": 1100,
        "height": 640,
        "minWidth": 1000,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png", "icons/icon.icns", "icons/icon.ico"]
  }
}

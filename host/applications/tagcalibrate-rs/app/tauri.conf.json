{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tag Calibrator",
  "version": "1.0.0",
  "identifier": "com.tagdesigns.tagcalibrate",
  "build": {
    "frontendDist": "dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Tag Calibrator v1.0",
        "width": 1040,
        "height": 800,
        "minWidth": 900,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png", "icons/icon.icns", "icons/icon.ico"]
  }
}

{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tag Programmer",
  "version": "2.0.0",
  "identifier": "com.tagdesigns.tagprogram",
  "build": {
    "frontendDist": "dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Tag Programmer v2.0",
        "width": 900,
        "height": 700,
        "minWidth": 720,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png"]
  }
}
